# MCP Photoshop Server Environment Configuration
# Copy this file to .env and modify as needed
# Or set these variables in your MCP client configuration

# MCP Transport: stdio (default — Cline/IDE) or streamable-http (Open WebUI, via run_openwebui.bat)
MCP_TRANSPORT=stdio

# ComfyUI Connection
COMFYUI_URL=http://127.0.0.1:8188

# ComfyUI Auto-Start Configuration (choose one method)
# Method 1: Using embedded Python (recommended)
COMFYUI_PYTHON=<path-to-comfyui>/python_embeded/python.exe
COMFYUI_MAIN=<path-to-comfyui>/ComfyUI/main.py
COMFYUI_ARGS=--windows-standalone-build

# Method 2: Using start command (alternative)
# COMFYUI_START_CMD=<path-to-comfyui>/start_comfyui.bat

# ComfyUI Lifecycle Management
COMFYUI_AUTO_KILL=1
COMFYUI_START_TIMEOUT=180
COMFYUI_IDLE_TIMEOUT=5

# VRAM Management
VRAM_PRESSURE_THRESHOLD_MB=8192

# WebSocket & Session Settings
WEBSOCKET_TIMEOUT=600
MAX_UNDO_STEPS=20

# Logging
LOG_LEVEL=WARNING

# Optional: ComfyUI directories (auto-detected if not set)
# COMFYUI_INPUT_DIR=<path-to-comfyui>/input
# COMFYUI_OUTPUT_DIR=<path-to-comfyui>/output

# Optional: master prompt files for get_prompt_guidance
# (defaults to the repository-local masters/ folder next to server.py)
# MASTER_PROMPT_DIR=<path-to-masters>

# Streamable-HTTP reachability (run_openwebui.bat sets MCP_HTTP_HOST=0.0.0.0)
# MCP_HTTP_HOST=127.0.0.1
# Optional comma-separated host:port patterns admitted by the transport
# allowlist (e.g. this machine's tailnet IP and MagicDNS name). Machine-
# specific: put real values in .env only, never in this template.
# MCP_HTTP_ALLOWED_HOSTS=